# Firebase-Konfiguration
#
# Diese VITE_-Werte sind KEINE Geheimnisse im klassischen Sinn (sie landen
# ohnehin sichtbar im Browser-Bundle) — der eigentliche Schutz der Daten
# passiert über die Firestore-Sicherheitsregeln (firebase/firestore.rules).
#
# 1. Diese Datei zu ".env.local" kopieren (wird von git ignoriert)
# 2. Werte aus der Firebase-Konsole eintragen:
#    Projekteinstellungen -> "Meine Apps" -> Web-App -> SDK-Konfiguration
# 3. Vite-Dev-Server neu starten, damit die Variablen geladen werden
#
# Ohne diese Werte läuft die App trotzdem (siehe src/lib/firebase.ts,
# firebaseEnabled-Flag) — nur ohne Login/Cloud-Sync.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nur nötig für Push-Benachrichtigungen (optional):
# Firebase-Konsole -> Projekteinstellungen -> Cloud Messaging -> "Web-Push-Zertifikate"
VITE_FIREBASE_VAPID_KEY=

# ── Nur für Vercel eintragen (server-seitig, NICHT hier/lokal, KEIN VITE_-Präfix!) ──
# Diese Werte kommen aus einem Firebase Service-Account-Schlüssel
# (Projekteinstellungen -> Dienstkonten -> "Neuen privaten Schlüssel generieren")
# und gehören ausschließlich in die Vercel-Umgebungsvariablen:
#   FIREBASE_ADMIN_PROJECT_ID=
#   FIREBASE_ADMIN_CLIENT_EMAIL=
#   FIREBASE_ADMIN_PRIVATE_KEY=
#   CRON_SECRET=            (frei wählbares eigenes Geheimnis für api/cron/*)
