rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Standard: jede*r angemeldete Person darf nur in den eigenen Ordner
    // (users/{uid}/...) schreiben, lesen dürfen alle angemeldeten Nutzer*innen
    // (praktisch für z.B. gemeinsam sichtbare Profilbilder). Bei Bedarf auf
    // "read: if request.auth.uid == userId" verschärfen.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
